{
  "name": "nanteyomu-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @nanteyomu/web dev",
    "data": "pnpm --filter @nanteyomu/data build && node scripts/sync-data.mjs",
    "build": "pnpm run data && pnpm --filter @nanteyomu/web build",
    "preview": "pnpm --filter @nanteyomu/web preview",
    "deploy": "pnpm run build && wrangler deploy",
    "lint:data": "pnpm --filter @nanteyomu/data lint",
    "test": "pnpm run lint:data && pnpm run data && pnpm --filter nanteyomu test && pnpm --filter @nanteyomu/mcp test"
  }
}
