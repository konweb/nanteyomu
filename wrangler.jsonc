{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // ビルドもデプロイもリポジトリのルートから行うため、設定もここに置く。
  // wrangler はワークスペースのルートに設定ファイルがないと
  // 「ワークスペースのルートでは実行できない」と言って止まる。
  "name": "nanteyomu",
  "compatibility_date": "2026-08-01",
  // カスタムドメイン。deploy 時に wrangler が DNS レコードとルートを作る。
  // Route パターン（*.nanteyomu.dev/* など）と違い、apex に確実に当たり、
  // DNS レコードを別途用意する必要もない。
  "routes": [
    { "pattern": "nanteyomu.dev", "custom_domain": true }
  ],
  // 「タメになった」ボタンの API。サイト本体は静的アセットのままで、
  // run_worker_first に挙げたパスだけがこの Worker に届く。
  "main": "./worker/index.ts",
  "assets": {
    // ルートからの相対パス。root の `pnpm build` がここに生成する。
    "directory": "./apps/web/dist",
    "not_found_handling": "404-page",
    // Worker から静的アセットを読むための binding。slug の実在確認に使う。
    "binding": "ASSETS",
    // ここに挙げたパスだけ Worker を先に通す。他は今までどおりアセット配信。
    "run_worker_first": ["/api/tame/*"]
  },
  "d1_databases": [
    {
      "binding": "REACTIONS",
      "database_name": "nanteyomu-reactions",
      "database_id": "24aeae79-4d72-4021-9c27-85489ac1ddf2",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": { "enabled": true }
}
