---
import Base from '../../layouts/Base.astro';
import Speak from '../../components/Speak.tsx';
import Share from '../../components/Share.astro';
import JsonLd from '../../components/JsonLd.astro';
import {
  entries, CATEGORY_LABEL, CONFIDENCE_LABEL, SOURCE_KIND_LABEL, primaryKana,
  sameCategoryEntries,
} from '../../lib/entries';
import { entrySchema } from '../../lib/schema';
import { EDIT_BASE, SITE_URL } from '../../lib/site';

export function getStaticPaths() {
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const kana = primaryKana(entry);
const others = entry.ja.filter((r) => r.kana !== kana);

const title = `${entry.term} の読み方は「${kana}」`;
const description = `${entry.term} は「${kana}」と読みます。${entry.summary}`;
const categoryLabel = CATEGORY_LABEL[entry.category] ?? entry.category;
const related = sameCategoryEntries(entry);
// 本文に答えそのものを一文で置く。title と meta にしか無いと
// 「◯◯ 読み方」で来た読者にも、引用する AI にも答えが見えない。
const answer = entry.en?.respelling
  ? `${entry.term} は日本では「${kana}」と読みます。英語圏での発音は ${entry.en.respelling} です。`
  : `${entry.term} は「${kana}」と読みます。`;
const shareText = `${entry.term} は「${kana}」と読む`;
---

<Base
  title={title}
  description={description}
  path={`/w/${entry.slug}/`}
  image={`/og/${entry.slug}.png`}
  imageAlt={`${entry.term} は「${kana}」と読みます`}
>
  <nav class="crumbs" aria-label="パンくずリスト">
    <a href="/">トップ</a>
    <a href={`/c/${entry.category}/`}>{categoryLabel}</a>
    <span aria-current="page">{entry.term}</span>
  </nav>

  <article>
    <header class="entry-head">
      <h1 class="entry-term mono">{entry.term}</h1>
      <p class="entry-kana">{kana}</p>

      <div class="entry-meta">
        <span class="badge">{CATEGORY_LABEL[entry.category] ?? entry.category}</span>
        <span class={`badge ${entry.confidence}`}>{CONFIDENCE_LABEL[entry.confidence]}</span>
        {entry.divergence && <span class="badge divergence">日英でズレる</span>}
        {entry.en?.ipa && <span class="badge mono">{entry.en.ipa}</span>}
        <Speak client:idle text={entry.term} />
      </div>

      <p class="entry-answer">{answer}</p>

      <p class="entry-summary">{entry.summary}</p>
      {entry.expansion && (
        <p class="entry-summary">
          <strong>何の略か:</strong> {entry.expansion}
        </p>
      )}
    </header>

    {entry.divergence && entry.divergenceNote && (
      <section class="section">
        <h2>日英のズレ</h2>
        <div class="callout"><p>{entry.divergenceNote}</p></div>
      </section>
    )}

    <section class="section">
      <h2>日本語での読み</h2>
      <ul class="readings">
        <li>
          <span class="k">{kana}</span>
          <span class="badge">主</span>
          {entry.ja.find((r) => r.kana === kana)?.note && (
            <span class="n">{entry.ja.find((r) => r.kana === kana)!.note}</span>
          )}
        </li>
        {others.map((r) => (
          <li>
            <span class="k">{r.kana}</span>
            {r.note && <span class="n">{r.note}</span>}
          </li>
        ))}
      </ul>
    </section>

    {entry.en && (entry.en.respelling || entry.en.ipa || entry.en.note) && (
      <section class="section">
        <h2>英語圏での発音</h2>
        <ul class="readings">
          {entry.en.respelling && (
            <li><span class="k mono">{entry.en.respelling}</span>
              {entry.en.ipa && <span class="n mono">{entry.en.ipa}</span>}
            </li>
          )}
          {entry.en.note && <li><span class="n">{entry.en.note}</span></li>}
        </ul>
      </section>
    )}

    <section class="section">
      <h2>出典</h2>
      {entry.sources && entry.sources.length > 0 ? (
        <ul class="sources">
          {entry.sources.map((s) => (
            <li>
              <span class="kind">{SOURCE_KIND_LABEL[s.kind] ?? s.kind}</span>
              <a href={s.url} rel="noopener nofollow">{s.title}</a>
              {s.quote && <blockquote class="quote">「{s.quote}」</blockquote>}
            </li>
          ))}
        </ul>
      ) : (
        <div class="callout">
          <p>
            この語はまだ出典を確認できていません（掲載している読みは慣用に基づく暫定値です）。
            一次情報をご存知の方は
            <a href={`${EDIT_BASE}/${entry.slug}.yml`}>
              このエントリを編集</a>して教えてください。
          </p>
        </div>
      )}
    </section>

    {related.length > 0 && (
      <section class="section">
        <h2>同じカテゴリの語</h2>
        <div class="card-grid">
          {related.map((e) => (
            <a class="card" href={`/w/${e.slug}/`}>
              <span class="term mono">{e.term}</span>
              <span class="kana">{primaryKana(e)}</span>
            </a>
          ))}
        </div>
        <p style="margin-top: 1.25rem;">
          <a href={`/c/${entry.category}/`}>{categoryLabel}をすべて見る →</a>
          ・<a href="/kana/">あいうえお順の索引</a>
        </p>
      </section>
    )}

    <Share text={shareText} url={`${SITE_URL}/w/${entry.slug}/`} />

    <div class="contribute">
      最終更新 {entry.updated} ・
      <a href={`${EDIT_BASE}/${entry.slug}.yml`}>
        このページを修正する
      </a>
    </div>
  </article>

  <JsonLd data={entrySchema(entry, title, description)} />
</Base>
