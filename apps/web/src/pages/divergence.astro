---
import Base from '../layouts/Base.astro';
import { divergentEntries, primaryKana } from '../lib/entries';
const list = divergentEntries();
---
<Base
  title="日英で読みがズレる語"
  description="英語圏での発音と、日本の現場で実際に通っている読みが食い違う用語の一覧。JWT、Kubernetes、PostgreSQL など。"
  path="/divergence/"
>
  <section class="hero" style="padding-bottom: 1rem;">
    <h1>日英で読みがズレる語</h1>
    <p>
      日本語話者が本当に困るのは「正しい発音」ではなく、
      <strong>英語圏の読みと日本の現場の通り名が食い違っていて、どちらで喋るべきか分からない</strong>ことです。
      そういう語だけを集めました。({list.length} 語)
    </p>
  </section>
  <div class="card-grid">
    {list.map((e) => (
      <a class="card" href={`/w/${e.slug}/`}>
        <span class="term mono">{e.term}</span>
        <span class="kana">{primaryKana(e)}</span>
        {e.divergenceNote && <div class="note">{e.divergenceNote}</div>}
      </a>
    ))}
  </div>
</Base>
