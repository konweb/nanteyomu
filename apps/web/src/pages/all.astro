---
import Base from '../layouts/Base.astro';
import { sortedEntries, primaryKana, CATEGORY_LABEL } from '../lib/entries';
const list = sortedEntries();
---
<Base title="収録語一覧" description="nanteyomu に収録されているツール名・サービス名の一覧。" path="/all/">
  <section class="hero" style="padding-bottom: 1rem;">
    <h1>収録語一覧</h1>
    <p>{list.length} 語</p>
  </section>
  <ul class="search-results">
    {list.map((e) => (
      <li>
        <a href={`/w/${e.slug}/`}>
          <span class="term mono">{e.term}</span>
          <span class="kana">{primaryKana(e)}</span>
          <span class="badge">{CATEGORY_LABEL[e.category] ?? e.category}</span>
          {e.divergence && <span class="badge divergence">日英でズレる</span>}
        </a>
      </li>
    ))}
  </ul>
</Base>
