---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import IndexView from '../components/IndexView.astro';
import { entries, alphabetIndex } from '../lib/entries';
const groups = alphabetIndex();
---
<Base
  title="アルファベット順の索引"
  description={`nanteyomu に収録している ${entries.length} 語を、綴りのアルファベット順に並べた索引。`}
  path="/all/"
>
  <section class="page-head">
    <div class="hero-top">
      <Logo size={56} />
      <h1>索引</h1>
    </div>
    <p>{entries.length} 語を綴りの順に並べています。</p>
  </section>

  <nav class="index-tabs" aria-label="並び順">
    <span class="is-current" aria-current="page">アルファベット順</span>
    <a href="/kana/">あいうえお順</a>
  </nav>

  <IndexView groups={groups} jumpLabel="頭文字へ移動" />
</Base>
