---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Search from '../components/Search.tsx';
import JsonLd from '../components/JsonLd.astro';
import { homeSchema } from '../lib/schema';
import { entries, divergentEntries, categoriesWithCounts, CATEGORY_LABEL, primaryKana } from '../lib/entries';
import { GITHUB_REPO } from '../lib/site';

const divergent = divergentEntries().slice(0, 6);
const categories = categoriesWithCounts();
const sourced = entries.filter((e) => (e.sources?.length ?? 0) > 0).length;
---

<Base
  title="nanteyomu — IT のツール名・サービス名の読み方辞典"
  description="tmux、nginx、Cloudflare Turnstile — IT のツール名・サービス名の読み方を、出典つきで引ける辞典。英語圏の発音と日本の現場での通り名の両方を収録しています。"
  path="/"
>
  <section class="hero">
    <div class="hero-top">
      <Logo size={88} class="bob" />
      <h1>そのツール、<br />なんて<span class="mark">読む</span>？</h1>
    </div>
    <p>
      IT のツール名・サービス名の読み方を、<strong>出典つき</strong>で引ける辞典です。
      英語圏での発音と、日本の現場で実際に通っている読みの<strong>両方</strong>を載せています。
    </p>

    <ul class="stats">
      <li class="stat"><b>{entries.length}</b> 語収録</li>
      <li class="stat"><b>{sourced}</b> 語に出典あり</li>
      <li class="stat"><b>{divergentEntries().length}</b> 語が日英でズレる</li>
    </ul>

    <Search client:load />

    <p class="lookup-links">
      <span class="lead">頭文字から辿る</span>
      <a href="/kana/">あいうえお順</a>
      <a href="/all/">アルファベット順</a>
    </p>
  </section>

  <section class="section">
    <h2>日英で読みがズレる語</h2>
    <p class="section-lead">
      日本語話者が本当に困るのは「正しい発音」より「英語圏の読みと日本の現場の通り名のズレ」です。
    </p>
    <div class="card-grid">
      {divergent.map((e) => (
        <a class="card" href={`/w/${e.slug}/`}>
          <span class="term mono">{e.term}</span>
          <span class="kana">{primaryKana(e)}</span>
          {e.divergenceNote && <div class="note">{e.divergenceNote.slice(0, 70)}…</div>}
        </a>
      ))}
    </div>
    <p style="margin-top: 1.25rem;"><a href="/divergence/">ズレる語をすべて見る →</a></p>
  </section>

  <section class="section">
    <h2>カテゴリ</h2>
    <div class="card-grid">
      {categories.map(({ category, count }) => (
        <a class="card" href={`/c/${category}/`}>
          <span class="term">{CATEGORY_LABEL[category] ?? category}</span>
          <div class="note">{count} 語</div>
        </a>
      ))}
    </div>
  </section>

  <div class="contribute">
    出典は作者本人の発言・公式ドキュメント・公式FAQ を優先し、推測で書かない方針です。
    確認できていない語は「出典なし（暫定値）」と明示しています。
    追加・修正は <a href={GITHUB_REPO}>GitHub</a> から Pull Request でどうぞ。
  </div>
  <JsonLd data={homeSchema(entries.length)} />
</Base>
