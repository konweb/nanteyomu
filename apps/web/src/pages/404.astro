---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Search from '../components/Search.tsx';
---
<Base title="ページが見つかりません" description="お探しのページは見つかりませんでした。" path="/404/">
  <section class="hero">
    <div class="hero-top">
      <Logo size={76} class="bob" />
      <h1>まだ収録されて<br />いないかも</h1>
    </div>
    <p>検索するか、GitHub で追加をリクエストしてください。</p>
    <Search client:load />
  </section>
</Base>
