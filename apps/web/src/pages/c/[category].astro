---
import Base from '../../layouts/Base.astro';
import { entries, CATEGORY_LABEL, primaryKana } from '../../lib/entries';

export function getStaticPaths() {
  const cats = [...new Set(entries.map((e) => e.category))];
  return cats.map((category) => ({
    params: { category },
    props: { category, list: entries.filter((e) => e.category === category) },
  }));
}

const { category, list } = Astro.props;
const label = CATEGORY_LABEL[category] ?? category;
---
<Base title={`${label} の読み方`} description={`${label} に分類される用語の読み方一覧。`} path={`/c/${category}/`}>
  <section class="hero" style="padding-bottom: 1rem;">
    <h1>{label}</h1>
    <p>{list.length} 語</p>
  </section>
  <ul class="search-results">
    {list.map((e) => (
      <li>
        <a href={`/w/${e.slug}/`}>
          <span class="term mono">{e.term}</span>
          <span class="kana">{primaryKana(e)}</span>
          {e.divergence && <span class="badge divergence">日英でズレる</span>}
        </a>
      </li>
    ))}
  </ul>
</Base>
