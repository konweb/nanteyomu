---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { LOGO_PATH, LOGO_SPRITE_ID } from '../lib/logo';
import { GITHUB_REPO, GTM_ID } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** ページ固有の canonical パス (例: /w/tmux/) */
  path?: string;
  /** OGP 画像のパス。省略するとサイト共通のものを使う */
  image?: string;
  /** OGP 画像の説明。省略するとサイト共通のものを使う */
  imageAlt?: string;
}

const { title, description, path, image, imageAlt } = Astro.props;
const canonical = new URL(path ?? Astro.url.pathname, Astro.site);
// OGP 画像は絶対 URL でないとクローラが解決できない
const ogImage = new URL(image ?? '/ogp.jpg', Astro.site);
// サイト名で始まるタイトル（トップ）はそのまま、それ以外は末尾にサイト名を足す
const fullTitle = title.startsWith('nanteyomu') ? title : `${title} | nanteyomu`;
// 計測タグは本番ビルドのときだけ。dev サーバーのアクセスを混ぜないため。
const gtm = import.meta.env.PROD && GTM_ID ? GTM_ID : null;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {gtm && (
      <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','${gtm}');`} />
    )}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="nanteyomu" />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? 'そのツール、なんて読む？ — IT のツール名・サービス名の読み方を出典つきで引ける辞典'} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="theme-color" content="#f6f1ff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171334" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- 見出し・カナ用の丸ゴシック。本文は端末のフォントのまま -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700&display=swap"
    />
  </head>
  <body>
    {gtm && (
      <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${gtm}"
height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />
    )}

    {/* ロゴの形状はここで1度だけ定義し、各 <Logo /> は <use> で参照する */}
    <svg class="sprite" aria-hidden="true" focusable="false">
      <defs><path id={LOGO_SPRITE_ID} d={LOGO_PATH} fill-rule="evenodd" /></defs>
    </svg>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/">
          <Logo size={32} />
          <span>nante<span class="ruby">yomu</span></span>
        </a>
        <nav class="site-nav">
          <a href="/divergence/"><span class="nav-full">日英でズレる語</span><span class="nav-short">ズレる語</span></a>
          <a href="/all/">すべて</a>
          <a href={GITHUB_REPO}>GitHub</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <Logo size={56} />
        <p>
          nanteyomu — IT のツール名・サービス名の読み方を、根拠つきで。
          データは <a href={GITHUB_REPO}>GitHub</a> で
          MIT ライセンスのもと公開しています。誤りの指摘・追加は Pull Request で歓迎します。
        </p>
      </div>
    </footer>
  </body>
</html>
